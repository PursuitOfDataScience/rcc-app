# Backups produced by refresh-docs.sh
.doc-backups/
refresh-docs.log

# Local checkout refresh-docs.sh clones the upstream User Guide into
.user-guide/

# Secrets — never commit an API key
.streamlit/secrets.toml

# Feedback sink (SAGE_FEEDBACK_LOG)
*.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Screenshots produced by tools/render_check.py
tools/*.png
tools/*.html

# Scratch git worktrees created for background agents. Transient by definition:
# each is a checkout of this repo, so committing one would commit the repo into
# itself. `.claude/` config that is meant to be shared can still be added by path —
# `.claude/settings.json` and `.claude/hooks/` are shared and tracked.
.claude/worktrees/

# Personal overrides: one developer's allowed commands and MCP servers, which have
# nothing to say to anybody else's checkout.
.claude/settings.local.json
